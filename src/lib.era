    }

    pub fn build(&self) -> ElementNode {
        return tw_grid(self.id.clone(), self.style_str.clone(), self.cols, self.children_list.clone());
    }
}

pub struct Stack {
    pub id: string,
    pub style_str: string,
    pub children_list: Vec<ElementNode>,
}

impl Stack {
    pub fn new(id: string, style: string) -> Stack {
        return Stack {
