// Fluent Class-Based Widgets
pub struct Container {
    pub id: string,
    pub style_str: string,
    pub on_click_id: string,
    pub child_node: Option<ElementNode>,
}

impl Container {
    pub fn new(id: string) -> Container {
        return Container {
            id,
            style_str: "".to_string(),
            on_click_id: "".to_string(),
            child_node: None,
        };
    }

    pub fn style(&mut self, s: string) {
        self.style_str = s;
    }

    pub fn on_click(&mut self, action: string) {
        self.on_click_id = action;
    }

    pub fn child(&mut self, c: ElementNode) {
        self.child_node = Some(c);
    }

    pub fn build(&self) -> ElementNode {
        let child = if self.child_node.is_some() { self.child_node.clone().unwrap() } else { ElementNode::new("empty".to_string(), "".to_string()) };
        let mut node = tw_box(self.id.clone(), self.style_str.clone(), child);
        if self.on_click_id.len() > 0 {
            node.on_click_id = self.on_click_id.clone();
        }
        return node;
    }
}

pub struct Row {
    pub id: string,
    pub style_str: string,
    pub children_list: Vec<ElementNode>,
}

impl Row {
    pub fn new(id: string, style: string) -> Row {
        return Row {
            id,
            style_str: style,
            children_list: Vec::<ElementNode>::new(),
        };
    }

    pub fn style(&mut self, s: string) {
        self.style_str = s;
    }

    pub fn add(&mut self, child: ElementNode) {
        self.children_list.push(child);
    }

    pub fn build(&self) -> ElementNode {
        return tw_row(self.id.clone(), self.style_str.clone(), self.children_list.clone());
    }
}

pub struct Column {
    pub id: string,
    pub style_str: string,
    pub children_list: Vec<ElementNode>,
}

impl Column {
    pub fn new(id: string, style: string) -> Column {
        return Column {
            id,
            style_str: style,
            children_list: Vec::<ElementNode>::new(),
        };
    }

    pub fn style(&mut self, s: string) {
        self.style_str = s;
    }

    pub fn add(&mut self, child: ElementNode) {
        self.children_list.push(child);
    }

    pub fn build(&self) -> ElementNode {
        return tw_col(self.id.clone(), self.style_str.clone(), self.children_list.clone());
    }
}

pub struct Grid {
    pub id: string,
    pub style_str: string,
    pub cols: i64,
    pub children_list: Vec<ElementNode>,
}

impl Grid {
    pub fn new(id: string, style: string, cols: i64) -> Grid {
        return Grid {
            id,
            style_str: style,
            cols,
            children_list: Vec::<ElementNode>::new(),
        };
